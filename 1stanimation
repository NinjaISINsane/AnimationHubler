function startRecording()
if rec.active then return end
if play.active then Fn.hardExit() end
local takes = {}
if mode == "ME" or mode == "DUAL" then
local c = player.Character
local t = c and Fn.newTake(c, "me")
if not t then toast("Your character isn't ready", "err") return end
takes[#takes + 1] = t
end
if mode == "TARGET" or mode == "DUAL" then
if not target or not target.Parent then toast("Click a character to target it first", "err") return end
if target == player.Character and mode == "DUAL" then toast("Target is you - pick someone else", "err") return end
local t = Fn.newTake(target, "target")
if not t then toast("Target has no root part", "err") return end
takes[#takes + 1] = t
end
if mode == "NPCS" then
if #NPC.sel == 0 then toast("Pick NPCs first (NPCS NEARBY card)", "err") return end
if CFG.npcWithMe then
local c = player.Character
local t = c and Fn.newTake(c, "me")
if t then takes[#takes + 1] = t end
end
for _, m in ipairs(NPC.sel) do
if m.Parent then
local t = Fn.newTake(m, (m.Name:gsub("[^%w]", "")))
if t then takes[#takes + 1] = t end
end
end
if #takes == 0 then toast("None of those NPCs can be recorded", "err") return end
end
rec.active, rec.takes, rec.t, rec.acc = true, takes, 0, 1e9
pending = {}
setStatus("recording [" .. takes[1].rig .. "]", THEME.red)
recConn = RunService.RenderStepped:Connect(function(dt)
rec.t = rec.t + dt
rec.acc = rec.acc + dt
local interval = CFG.fps > 0 and 1 / CFG.fps or 0
if rec.acc >= interval then
rec.acc = 0
for _, take in ipairs(rec.takes) do
local gap = rec.t - take.lastTick
take.lastTick = rec.t
local st = "main"
if not CFG.recIdle or not CFG.recWalk then st = Fn.classify(take) end
take.state = st
if (st == "idle" and not CFG.recIdle) or (st == "walk" and not CFG.recWalk) then
take.skipT = take.skipT + gap
else
Fn.sampleTake(take, rec.t - take.skipT)
end
end
if not rec.takes[1].root.Parent then
toast("Recording subject disappeared", "err")
stopRecording()
elseif #rec.takes[1].frames >= MAX_FRAMES then
toast("Max length reached", "err")
stopRecording()
end
end
end)
refreshRecordUI()
end
function stopRecording()
if not rec.active then return end
rec.active = false
if recConn then recConn:Disconnect() recConn = nil end
pending = {}
local link = #rec.takes > 1 and ("rec" .. tostring(os.time())) or nil
for i, take in ipairs(rec.takes) do
local n = #take.frames
if n >= 2 then
local t0 = take.frames[1].t
local dur = take.frames[n].t - t0
for _, f in ipairs(take.frames) do f.t = f.t - t0 end
pending[#pending + 1] = {name = "", label = take.label, rig = take.rig, fps = math.floor((n - 1) / math.max(dur, 1e-3) + 0.5), duration = dur, frames = take.frames, link = link, offset = (i > 1 and rec.takes[1].startCF and take.startCF) and rec.takes[1].startCF:ToObjectSpace(take.startCF) or nil}
end
end
rec.takes = {}
if #pending > 0 then
setStatus("take ready", THEME.green)
toast("Recorded " .. #pending[1].frames .. " frames", "ok")
else
setStatus("nothing recorded", THEME.accent)
toast("Too short - nothing recorded", "err")
end
refreshRecordUI()
end
function Fn.applyPose(t)
for _, tr in ipairs(scene) do
local c = tr.clone
if c and tr.frames and tr.anim then
local hrp = c:FindFirstChild("HumanoidRootPart")
if hrp then
for k in pairs(scratch) do scratch[k] = nil end
local lt = math.clamp(t - tr.delay, 0, tr.anim.duration)
local rootRel, parts = Fn.poseAt(tr.frames, lt)
local mir = CFG.mirror ~= tr.mirror
if mir then rootRel = Fn.mirrorCF(rootRel) end
local rootCF = tr.base * (CFG.rootMotion and rootRel or CFrame.new())
hrp.CFrame = rootCF
for n, cf in pairs(parts) do
local name, cc = n, cf
if mir then cc = Fn.mirrorCF(cf) name = SWAP[n] or n end
local p = c:FindFirstChild(name)
if p and p:IsA("BasePart") then p.CFrame = rootCF * cc end
end
end
end
end
end
function Fn.beginRig()
if #scene == 0 then scene[1] = {anim = play.anim, frames = play.frames, delay = 0, mirror = false} end
local need = false
for _, tr in ipairs(scene) do
if not tr.clone or not tr.clone.Parent then need = true end
end
if need and not Fn.layoutScene() then return false end
if not play.active then
play.active = true
for _, tr in ipairs(scene) do
tr.base = tr.clone.HumanoidRootPart.CFrame
Fn.setCloneRig(tr, true)
end
end
return true
end
