corner(fill, 4)
local knob = new("Frame", {Parent = track, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 4})
corner(knob, 8)
stroke(knob, THEME.stroke, 2)
