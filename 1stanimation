function Fn.classify(take)
local root = take.root
local now = os.clock()
local pos = root.Position
local dtc = take.prevClock and math.max(now - take.prevClock, 1e-3) or 1
local speed = 0
if take.prevPos then
speed = Vector3.new(pos.X - take.prevPos.X, 0, pos.Z - take.prevPos.Z).Magnitude / dtc
end
take.prevPos, take.prevClock = pos, now
local main, walk, idle = false, false, false
if take.animator then
local ok, tracks = pcall(function() return take.animator:GetPlayingAnimationTracks() end)
if ok and tracks then
for _, t in ipairs(tracks) do
local w = 1
