local char = player.Character
local hrp = char and char:FindFirstChild("HumanoidRootPart")
if not hrp then toast("No character", "err") return end
NPC.busy = true
Fn.npcRefreshList()
local origin, radius = hrp.Position, CFG.npcRadius
task.spawn(function()
local found, seen = {}, {}
local ok, desc = pcall(function() return Workspace:GetDescendants() end)
if ok then
for i, d in ipairs(desc) do
if i % 4000 == 0 then task.wait() end
if d:IsA("Humanoid") or d:IsA("AnimationController") then
local m = d.Parent
if m and m:IsA("Model") and not seen[m] and m ~= char and m.Name ~= "StealerClone" and not Players:GetPlayerFromCharacter(m) then
seen[m] = true
local root = Fn.getRoot(m)
if root and Fn.detectRig(m) ~= "?" then
local dist = (root.Position - origin).Magnitude
if dist <= radius then found[#found + 1] = {model = m, dist = dist} end
end
end
end
end
end
table.sort(found, function(a, b) return a.dist < b.dist end)
NPC.list = found
NPC.busy = false
Fn.npcRefreshList()
toast("Found " .. #found .. " NPC(s) within " .. radius .. " studs", #found > 0 and "ok" or nil)
end)
end
