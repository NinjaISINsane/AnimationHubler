local function bufferStep(dt)
buf.t = buf.t + dt
buf.acc = buf.acc + dt
buf.trim = buf.trim + dt
local subject = (mode ~= "ME" and target and target.Parent) and target or player.Character
if not subject then return end
if not buf.take or buf.take.model ~= subject or not buf.take.root.Parent then
buf.take = newTake(subject, "replay")
buf.t, buf.acc = 0, 0
if not buf.take then return end
end
if buf.acc >= 1 / 30 then
buf.acc = 0
sampleTake(buf.take, buf.t)
end
if buf.trim >= 1 then
buf.trim = 0
local fr, cutoff = buf.take.frames, buf.t - CFG.bufferSecs - 2
local idx = 1
while fr[idx] and fr[idx].t < cutoff do idx = idx + 1 end
if idx > 1 then
local n = #fr
local keep = n - idx + 1
for i = 1, keep do fr[i] = fr[idx + i - 1] end
for i = keep + 1, n do fr[i] = nil end
end
end
end
local function grabBuffer()
local tk = buf.take
if not CFG.bufferOn or not tk or #tk.frames < 4 then toast("Turn the replay buffer on and give it a moment", "err") return end
local cutoff = buf.t - CFG.bufferSecs
local out, first = {}, nil
for _, f in ipairs(tk.frames) do
if f.t >= cutoff then
first = first or f
out[#out + 1] = {t = f.t - first.t, root = first.root:ToObjectSpace(f.root), parts = f.parts}
end
end
if #out < 4 then toast("Not enough buffered yet", "err") return end
pending = {{name = "", label = "replay", rig = tk.rig, fps = 30, duration = out[#out].t, frames = out}}
