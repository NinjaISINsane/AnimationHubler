if play.revHold then
if play.time <= 0 then play.time = 0 end
elseif play.dir > 0 and play.time >= hi then
if CFG.loop then
play.time = lo + (play.time - lo) % (hi - lo)
else
play.time, play.paused = hi, true
refreshPlayUI()
end
elseif play.dir < 0 and play.time <= lo then
if CFG.loop then
play.time = hi - (lo - play.time) % (hi - lo)
