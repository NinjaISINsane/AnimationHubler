local function mirrorCF(cf)
local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end
local function avgCF(list)
if #list == 1 then return list[1] end
local sum = Vector3.new(0, 0, 0)
for _, cf in ipairs(list) do sum = sum + cf.Position end
return CFrame.new(sum / #list) * (list[1] - list[1].Position)
end
local function convertR15Parts(parts)
local out = {}
for r6Name, srcNames in pairs(R15_TO_R6) do
local list = {}
for _, n in ipairs(srcNames) do if parts[n] then list[#list + 1] = parts[n] end end
if #list > 0 then out[r6Name] = avgCF(list) end
end
return out
end
local function getPlayable(anim)
if anim.playable then return anim.playable end
if anim.rig ~= "R15" then anim.playable = anim.frames return anim.frames end
local out = {}
for i, f in ipairs(anim.frames) do out[i] = {t = f.t, root = f.root, parts = convertR15Parts(f.parts)} end
anim.playable = out
return out
end
local function findIndex(frames, t)
local lo, hi = 1, #frames
while lo < hi do
local mid = math.floor((lo + hi + 1) / 2)
if frames[mid].t <= t then lo = mid else hi = mid - 1 end
end
return lo
end
local scratch = {}
local function poseAt(frames, t)
local i = findIndex(frames, t)
local a, b = frames[i], frames[i + 1]
if not b then return a.root, a.parts end
local alpha = math.clamp((t - a.t) / math.max(b.t - a.t, 1e-5), 0, 1)
for n, cf in pairs(a.parts) do
local cb = b.parts[n]
scratch[n] = cb and cf:Lerp(cb, alpha) or cf
end
return a.root:Lerp(b.root, alpha), scratch
end
local function serializeAnim(a)
local out = {version = 2, name = a.name, animType = a.rig, duration = round(a.duration, 4), fps = a.fps, frames = {}}
for i, f in ipairs(a.frames) do
local pf = {}
for n, cf in pairs(f.parts) do pf[n] = cfToArr(cf) end
out.frames[i] = {t = round(f.t, 4), root = cfToArr(f.root), parts = pf}
end
return HttpService:JSONEncode(out)
end
local function deserializeAnim(json, name)
local ok, raw = pcall(function() return HttpService:JSONDecode(json) end)
if not ok or type(raw) ~= "table" then return nil end
local anim = {name = name, rig = "?", fps = 60, frames = {}, duration = 0}
if raw.version == 2 then
anim.rig = raw.animType or "?"
anim.fps = raw.fps or 60
for i, f in ipairs(raw.frames) do
local parts = {}
for n, a in pairs(f.parts) do parts[n] = arrToCF(a) end
anim.frames[i] = {t = f.t, root = arrToCF(f.root), parts = parts}
end
else
local list = raw.frames or raw
anim.rig = raw.animType or "?"
local first
for _, rf in ipairs(list) do
local abs = {}
for n, a in pairs(rf) do abs[n] = arrToCF(a) end
local rootName = (abs.HumanoidRootPart and "HumanoidRootPart") or (abs.Torso and "Torso") or (abs.UpperTorso and "UpperTorso")
if rootName then
local rootCF = abs[rootName]
first = first or rootCF
local parts = {}
for n, cf in pairs(abs) do if n ~= rootName then parts[n] = rootCF:ToObjectSpace(cf) end end
anim.frames[#anim.frames + 1] = {t = #anim.frames / 60, root = first:ToObjectSpace(rootCF), parts = parts}
end
end
end
if #anim.frames < 2 then return nil end
anim.duration = anim.frames[#anim.frames].t
return anim
end
