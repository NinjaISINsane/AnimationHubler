local function makeSlider(parent, min, max, value, onChange, onBegin, onEnd)
local holder = new("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Active = true})
local track = new("Frame", {Parent = holder, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = THEME.inset, BorderSizePixel = 0})
